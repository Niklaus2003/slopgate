# ==============================================================================
# SlopGate Git Ignore Rules
# ==============================================================================

# Virtual Environments
.venv/
env/
venv/
ENV/

# Python Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
dist/
build/
*.egg-info/

# Testing, Linting & Coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# SlopGate Local SQLite Databases & WAL files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/cache/

# Secrets & Environment Configurations (NEVER COMMIT)
.env
.env.local
.env.*.local

# Cloned Reference Repositories
_refs/

# Utility & Benchmark Scripts
scripts/

# Next.js Build Output & Frontend Dependencies
web/.next/
web/out/
web/node_modules/
.next/
node_modules/

# Submission Media & Walkthrough Recordings (Deliverables stored in artifacts/docs)
data/voiceover/
*.mp4
*.mp3
*.wav
*.aac
*.m4a
*.flac
*.ogg
*.webp
*.tmp
*.temp
.tempmediaStorage/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.log

# Local Experiment Reports
reports/backtest.md
