# ==============================================================================
# SlopGate Environment Configuration
# Copy this file to `.env` and fill in the values: `cp .env.example .env`
# ==============================================================================

# ---- AWS / Amazon Bedrock Configuration ----
# AWS Region where Bedrock is enabled (us-east-1 recommended)
AWS_REGION=us-east-1

# Recommended Bedrock model: Nova Micro is lowest cost ($0.035 / 1M input tokens)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Standard IAM User Credentials:
# Create via AWS Console -> IAM -> Users -> Your User -> Security credentials -> Create Access Key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# IMPORTANT AWS NOTES:
# 1. AWS_SESSION_TOKEN:
#    LEAVE BLANK if using permanent IAM credentials (AKIA...).
#    Only fill this if using temporary session credentials (e.g., AWS STS, AWS SSO, ASIA...).
# 2. AWS_BEARER_TOKEN_BEDROCK:
#    LEAVE BLANK if using IAM Access Keys. Setting both IAM keys and Bearer Token breaks AWS SigV4 signing.
# 3. New AWS Accounts Gotcha:
#    If Bedrock returns "ValidationException: Operation not allowed", your new AWS account is undergoing
#    backend verification. This normally resolves automatically within 1 to 2 hours.
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# ---- GitHub Configuration ----
# GITHUB_TOKEN:
# Personal Access Token (classic or fine-grained) for reading public repos (e.g. pallets/flask).
# Grants 5,000 requests/hour instead of the anonymous 60 requests/hour limit. No write permissions required.
GITHUB_TOKEN=

# GITHUB_WRITE_TOKEN:
# ONLY required for running live triage actions on your OWN test sandbox repository.
# Needs 'issues:write' and 'pull_requests:write' permissions.
# Leave blank during offline backtesting or read-only runs.
GITHUB_WRITE_TOKEN=

# GITHUB_SANDBOX_REPO:
# Your dedicated test repository in "owner/repository" format.
# Example: "Niklaus2003/slopgate-sandbox" (do NOT include "https://" or ".git").
GITHUB_SANDBOX_REPO=

# ---- SlopGate Safety & Behavior Flags ----
# 1 = Simulated actions only (prints planned labels/comments; never writes to GitHub).
# 0 = Live execution (only allowed on GITHUB_SANDBOX_REPO).
SLOPGATE_DRY_RUN=1

# Hard budget caps for Bedrock calls and output generation
SLOPGATE_MAX_BEDROCK_CALLS=50
SLOPGATE_MAX_OUTPUT_TOKENS=150

# Local Strands Decider 2B Settings (in-process CPU execution)
SLOPGATE_DECIDER_THREADS=4
SLOPGATE_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v21
SLOPGATE_DECIDER_DEVICE=cpu

# ---- Optional: Open-Weight OSS Engine (Groq Cloud) ----
# Active while AWS Bedrock account tier verification is pending or for zero-cost rapid experimentation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
